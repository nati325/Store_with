generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  description String      @default("")
  category    String      @default("")
  imageUrl    String      @default("")
  basePrice   Int // באגורות, מחיר ליחידה ללא מע"מ
  minQty      Int         @default(1)
  active      Boolean     @default(true)
  branding    String      @default("") // שיטות מיתוג, למשל "הדפסה, חריטה"
  leadTime    String      @default("") // זמן אספקה, למשל "5-10 ימי עסקים"
  tags        String      @default("") // תגיות מופרדות בפסיק, לדפי חג
  tiers       PriceTier[]
  orderItems  OrderItem[]
  choices     ProgramChoice[]
  createdAt   DateTime    @default(now())
}

model PriceTier {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  unitPrice Int // באגורות

  @@unique([productId, minQty])
}

model Order {
  id           Int         @id @default(autoincrement())
  number       String      @unique
  status       String      @default("NEW") // NEW | CONFIRMED | PAID | SHIPPED | CANCELLED
  customerName String
  company      String
  taxId        String      @default("")
  email        String
  phone        String
  address      String
  eventDate    String      @default("")
  notes        String      @default("")
  token        String      @default("") // סוד לגישת הלקוח לדף ההזמנה
  logoUrl      String      @default("") // לוגו שהלקוח העלה להדפסה
  shipTo       String      @default("") // כתובות נוספות וחלוקת כמויות
  proofUrl     String      @default("") // הדמיה שנשלחה לאישור
  proofStatus  String      @default("NONE") // NONE | SENT | APPROVED | CHANGES
  proofNote    String      @default("") // הערת העסק על ההדמיה
  proofReply   String      @default("") // תגובת הלקוח
  paymentUrl   String      @default("")
  lowProfileId String      @default("") // מזהה דף התשלום האחרון ב-Cardcom
  paidAmount   Int         @default(0) // באגורות, כפי שאומת מול Cardcom
  invoiceUrl   String      @default("") // קישור לחשבונית שהופקה
  invoiceNo    String      @default("")
  adminNotes   String      @default("")
  paidAt       DateTime?
  subtotal     Int // באגורות, ללא מע"מ
  vat          Int
  total        Int
  items        OrderItem[]
  createdAt    DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  qty       Int
  unitPrice Int
}

model QuoteRequest {
  id        Int      @id @default(autoincrement())
  name      String
  company   String
  email     String
  phone     String
  message   String
  product   String   @default("")
  kind      String   @default("QUOTE") // QUOTE | SAMPLE
  status    String   @default("NEW") // NEW | DONE
  createdAt DateTime @default(now())
}

model Campaign {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  title     String
  intro     String    @default("")
  tag       String    // מוצרים עם התגית הזו מוצגים בדף
  active    Boolean   @default(true)
  deadline  DateTime? // מועד אחרון מומלץ להזמנה
  createdAt DateTime  @default(now())
}

model GiftProgram {
  id           Int             @id @default(autoincrement())
  token        String          @unique
  company      String
  contactEmail String          @default("")
  message      String          @default("")
  budget       Int // תקציב מקסימלי לעובד, באגורות
  deadline     DateTime?
  status       String          @default("OPEN") // OPEN | CLOSED
  choices      ProgramChoice[]
  createdAt    DateTime        @default(now())
}

model ProgramChoice {
  id        Int         @id @default(autoincrement())
  programId Int
  program   GiftProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  email     String
  address   String      @default("")
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([programId, email])
}
